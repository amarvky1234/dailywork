<?xml version="1.0" encoding="UTF-8" ?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="weatherWidget" class="com.di.beans.WeatherWidget">
        <!--<property name="weatherFinder" ref="dellWeatherFinder"/>-->
        <constructor-arg ref="oracleWeatherFinder"/>
    </bean>
    <bean id="oracleWeatherFinder" class="com.di.beans.OracleWeatherFinderImpl"/>
    <bean id="dellWeatherFinder" class="com.di.beans.DellWeatherFinderImpl"/>

</beans>