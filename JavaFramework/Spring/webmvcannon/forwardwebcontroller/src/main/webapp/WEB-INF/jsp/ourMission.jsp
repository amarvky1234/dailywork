<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Our Mission</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #f5f7fa;
            color: #333;
        }

        .header {
            background-color: #1abc9c;
            color: white;
            text-align: center;
            padding: 35px;
        }

        .header h1 {
            margin: 0;
            font-size: 40px;
        }

        .header p {
            margin-top: 10px;
            font-size: 18px;
        }

        .container {
            width: 85%;
            margin: 40px auto;
        }

        .intro {
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 3px 10px #ddd;
        }

        .intro h2 {
            color: #1abc9c;
        }

        .intro p {
            line-height: 1.7;
            font-size: 17px;
        }

        .mission-container {
            display: flex;
            gap: 25px;
            margin-top: 30px;
        }

        .card {
            flex: 1;
            background-color: white;
            padding: 25px;
            text-align: center;
            border-radius: 10px;
            box-shadow: 0 3px 10px #ddd;
        }

        .icon {
            font-size: 50px;
        }

        .card h3 {
            color: #1abc9c;
        }

        .card p {
            line-height: 1.6;
            color: #555;
        }

        .vision {
            margin-top: 30px;
            background-color: #2c3e50;
            color: white;
            padding: 30px;
            text-align: center;
            border-radius: 10px;
        }

        .vision h2 {
            margin-top: 0;
        }

        footer {
            margin-top: 40px;
            background-color: #2c3e50;
            color: white;
            text-align: center;
            padding: 15px;
        }

        @media (max-width: 700px) {
            .mission-container {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

    <!-- Header -->
    <div class="header">
        <h1>Our Mission</h1>
        <p>Making a positive difference every day</p>
    </div>

    <div class="container">

        <!-- Introduction -->
        <div class="intro">
            <h2>What Drives Us?</h2>

            <p>
                Our mission is to inspire and empower individuals to reach
                their full potential. We work together to create meaningful
                connections, encourage innovation, and bring positive change
                to communities around the world.
            </p>
        </div>

        <!-- Mission Cards -->
        <div class="mission-container">

            <div class="card">
                <div class="icon">🎯</div>

                <h3>Our Goal</h3>

                <p>
                    We focus on creating solutions that help people grow,
                    succeed, and achieve their goals.
                </p>
            </div>


            <div class="card">
                <div class="icon">🤝</div>

                <h3>Collaboration</h3>

                <p>
                    We believe that working together creates stronger ideas
                    and better results for everyone.
                </p>
            </div>


            <div class="card">
                <div class="icon">💡</div>

                <h3>Innovation</h3>

                <p>
                    We continuously explore new ideas and technologies to
                    create meaningful improvements.
                </p>
            </div>

        </div>

        <!-- Values -->
        <div class="mission-container">

            <div class="card">
                <div class="icon">❤️</div>

                <h3>Respect</h3>

                <p>
                    We treat every individual with respect, fairness,
                    and understanding.
                </p>
            </div>


            <div class="card">
                <div class="icon">🌍</div>

                <h3>Positive Impact</h3>

                <p>
                    We aim to make a lasting and positive impact on
                    people and communities.
                </p>
            </div>


            <div class="card">
                <div class="icon">🔒</div>

                <h3>Integrity</h3>

                <p>
                    We believe in honesty, transparency, and doing the
                    right thing.
                </p>
            </div>

        </div>

        <!-- Vision -->
        <div class="vision">

            <h2>Our Vision</h2>

            <p>
                To build a better future where everyone has the opportunity
                to learn, grow, innovate, and make a difference.
            </p>

        </div>

    </div>

    <!-- Footer -->
    <footer>
        © 2025 Your Organization. All rights reserved.
    </footer>

</body>
</html>